<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".ListInfoActivity">

    <Button
        android:id="@+id/GoToCompareSearchButton"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="133dp"
        android:layout_height="54dp"
        android:layout_marginTop="4dp"
        android:backgroundTint="#19181B"
        android:onClick="goToCityForCompareActivity"
        android:text="Siirry vertailuun"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.003"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/GoToVisaButton"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="130dp"
        android:layout_height="54dp"
        android:layout_marginStart="1dp"
        android:layout_marginTop="4dp"
        android:backgroundTint="#19181B"
        android:text="Siirry visaan"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.04"
        app:layout_constraintStart_toEndOf="@+id/GoToCompareSearchButton"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/GoToHomeButton"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="133dp"
        android:layout_height="54dp"
        android:layout_marginTop="4dp"
        android:backgroundTint="#19181B"
        android:onClick="goToHome"
        android:text="Siirry kuntahakuun"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.996"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/InfoFragmentLayout"
        android:layout_width="409dp"
        android:layout_height="672dp"
        android:layout_marginTop="56dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>